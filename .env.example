# Upstash Redis (auto-populated if you add the Upstash integration from the Vercel Marketplace)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Resend (https://resend.com) — free tier is plenty
RESEND_API_KEY=
ALERT_EMAIL_TO=you@example.com
# Until you verify a domain in Resend, this sender can only deliver to your Resend account's own email
ALERT_EMAIL_FROM=Dashboard Uptime <onboarding@resend.dev>

# Optional: Slack incoming webhook for alerts (see NOTIF_SETUP.md)
SLACK_WEBHOOK_URL=

# Shared secret the scheduler must send: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Optional: Formlabs Web API credentials (Dashboard -> Developer Tools).
# Without these only the unauthenticated checks run.
FORMLABS_CLIENT_ID=
FORMLABS_CLIENT_SECRET=

# Optional: consecutive failures before an alert email fires (default 2)
ALERT_AFTER_FAILURES=2
# Optional: public URL of this status page, used as a link in emails
STATUS_PAGE_URL=
